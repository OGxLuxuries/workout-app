{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workout-competition",
  "main": "server/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workout-competition",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "APP_ORIGIN": "http://localhost:5173", "DEV_AUTH": "false" },
  "env": {
    "production": {
      "name": "workout-competition",
      "account_id": "956c781e436e230d7acdfbed1fcb17ed",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "workout.olivergomesjr.com", "custom_domain": true },
      ],
      "vars": {
        "APP_ORIGIN": "https://workout.olivergomesjr.com",
        "DEV_AUTH": "false",
        "AUTH_PROVIDER": "google",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "workout-competition",
          "database_id": "67258fdc-c11f-45ef-af4d-949e48a5048a",
          "migrations_dir": "migrations",
        },
      ],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": false },
      },
    },
  },
}
