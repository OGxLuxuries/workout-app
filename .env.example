# Copy to .dev.vars (never commit .dev.vars).
APP_ORIGIN=http://localhost:5173
DEV_AUTH=false
BOOTSTRAP_INVITE=replace-with-a-long-random-first-user-invitation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
